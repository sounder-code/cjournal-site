  <script is:inline id="apartment-map-data" type="application/json" set:html={JSON.stringify(mapApartments).replace(/</g, '\\u003c')}></script>
  <script is:inline>
    (() => {
      if (new URLSearchParams(window.location.search).get('embed') === 'map') return;
      const shell = document.querySelector('[data-apartment-landing]');
      const mapElement = document.querySelector('#apartment-landing-map');
      const payload = document.querySelector('#apartment-map-data');
      if (!(shell instanceof HTMLElement) || !(mapElement instanceof HTMLElement) || !payload) return;

      const apartments = JSON.parse(payload.textContent || '[]');
      if (!apartments.length) {
        mapElement.innerHTML = '<p class="map-unavailable">공개 좌표를 확인 중입니다.</p>';
        return;
      }

      const escapeHtml = (value) => String(value)
        .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
      const initMap = () => {
        if (!window.naver?.maps) return;
        const selected = apartments.find((item) => item.selected) || apartments[0];
        const map = new window.naver.maps.Map(mapElement, {
          center: new window.naver.maps.LatLng(selected.la, selected.lo),
          zoom: 16,
          minZoom: 11,
          zoomControl: true,
          zoomControlOptions: { position: window.naver.maps.Position.TOP_RIGHT },
          mapDataControl: false,
          scaleControl: false,
          logoControlOptions: { position: window.naver.maps.Position.BOTTOM_LEFT }
        });
        const bounds = new window.naver.maps.LatLngBounds();
        apartments.forEach((item) => {
          const position = new window.naver.maps.LatLng(item.la, item.lo);
          bounds.extend(position);
          const fee = new Intl.NumberFormat('ko-KR').format(item.tf || 0);
          const marker = new window.naver.maps.Marker({
            map,
            position,
            zIndex: item.selected ? 100 : 20,
            icon: {
              content: `<div class="landing-apt-marker${item.selected ? ' is-selected' : ''}"><strong>${escapeHtml(item.n)}</strong><span>${fee}원/㎡</span></div>`,
              anchor: new window.naver.maps.Point(14, 48)
            }
          });
          if (!item.selected) {
            window.naver.maps.Event.addListener(marker, 'click', () => {
              window.location.href = `/apartments/${encodeURIComponent(item.s)}/`;
            });
          }
        });
        if (apartments.length > 1) {
          map.fitBounds(bounds, { top: 100, right: 70, bottom: 90, left: 70 });
        }
      };

      if (window.naver?.maps) {
        initMap();
        return;
      }
      const script = document.createElement('script');
      script.src = `https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${encodeURIComponent(shell.dataset.mapClientId || '')}`;
      script.async = true;
      script.addEventListener('load', initMap, { once: true });
      script.addEventListener('error', () => {
        mapElement.innerHTML = '<p class="map-unavailable">지도를 불러오지 못했습니다. 전체 지도에서 다시 확인해 주세요.</p>';
      }, { once: true });
      document.head.appendChild(script);
    })();
  </script>
  <script is:inline>
    document.querySelectorAll('[data-fee-estimator]').forEach((root) => {
      const input = root.querySelector('[data-estimator-area]');
      if (!(input instanceof HTMLInputElement)) return;
      const fees = {
        total: Number(root.dataset.total || 0),
        common: Number(root.dataset.common || 0),
        individual: Number(root.dataset.individual || 0),
        reserve: Number(root.dataset.reserve || 0)
      };
      const formatter = new Intl.NumberFormat('ko-KR', { maximumFractionDigits: 0 });
      const render = () => {
        const area = Math.max(0, Math.min(500, Number(input.value) || 0));
        Object.entries(fees).forEach(([key, fee]) => {
          const target = root.querySelector(`[data-estimator-${key}]`);
          if (target) target.textContent = `${formatter.format(Math.round(fee * area))}원`;
        });
      };
      input.addEventListener('input', render);
    });
  </script>
</BaseLayout>

